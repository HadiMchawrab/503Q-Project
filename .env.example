APP_ENV=development
JWT_SECRET=change-me-in-production
JWT_ISSUER=shopcloud-local-auth
JWT_EXPIRATION_HOURS=8

ADMIN_EMAIL=admin@shopcloud.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=ShopCloud Admin

POSTGRES_USER=shopcloud
POSTGRES_PASSWORD=shopcloud
POSTGRES_DB=shopcloud
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=6380
DATABASE_URL=postgres://shopcloud:shopcloud@postgres:5432/shopcloud
REDIS_URL=redis://redis:6379

CATALOG_SERVICE_URL=http://catalog:3001
CART_SERVICE_URL=http://cart:3002
CHECKOUT_SERVICE_URL=http://checkout:3003
AUTH_SERVICE_URL=http://auth:3004
ADMIN_SERVICE_URL=http://admin:3005

# AWS — only used in EKS. In local dev leave INVOICE_QUEUE_URL empty so
# checkout's publish_invoice_event no-ops (see shared/queue.py).
AWS_REGION=eu-west-1
INVOICE_QUEUE_URL=

# Cognito — leave empty in dev. shared/auth.py falls back to local HS256 JWTs
# (signed with JWT_SECRET above) when COGNITO_USER_POOL_ID is unset. In prod
# these are populated from terraform output.
COGNITO_USER_POOL_ID=
COGNITO_ADMIN_POOL_ID=
COGNITO_CLIENT_ID=

GATEWAY_HOST_PORT=8080
