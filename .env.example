APP_ENV=development

# Local dev auth — only used when APP_ENV != production AND no Cognito pool is set.
# In that mode auth issues HS256 tokens via /login + /register, and the auth
# service seeds an admin user on first boot.
JWT_SECRET=dev-only-not-for-production
JWT_ISSUER=shopcloud-local-auth
JWT_EXPIRATION_HOURS=8
ADMIN_EMAIL=admin@shopcloud.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=ShopCloud Admin

POSTGRES_USER=shopcloud
POSTGRES_PASSWORD=shopcloud
POSTGRES_DB=shopcloud
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=6380
DATABASE_URL=postgres://shopcloud:shopcloud@postgres:5432/shopcloud
REDIS_URL=redis://redis:6379

CATALOG_SERVICE_URL=http://catalog:3001
CART_SERVICE_URL=http://cart:3002
CHECKOUT_SERVICE_URL=http://checkout:3003
AUTH_SERVICE_URL=http://auth:3004
ADMIN_SERVICE_URL=http://admin:3005

# AWS — only used in EKS. In local dev leave INVOICE_QUEUE_URL empty so
# checkout's publish_invoice_event no-ops (see shared/queue.py).
AWS_REGION=eu-west-1
INVOICE_QUEUE_URL=

# Cognito — required. Populate from `terraform output` after applying
# infra/terraform/environments/prod. The services have no local-auth fallback;
# at least one pool ID must be set or every authenticated request returns 500.
COGNITO_USER_POOL_ID=
COGNITO_ADMIN_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ADMIN_CLIENT_ID=
# Hosted UI domains (terraform: cognito_customer_hosted_ui_domain / _admin_)
COGNITO_CUSTOMER_DOMAIN=
COGNITO_ADMIN_DOMAIN=

GATEWAY_HOST_PORT=8080
