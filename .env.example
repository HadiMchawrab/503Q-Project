APP_ENV=development
JWT_SECRET=change-me-in-production
JWT_ISSUER=shopcloud-local-auth
JWT_EXPIRATION_HOURS=8

ADMIN_EMAIL=admin@shopcloud.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=ShopCloud Admin

POSTGRES_USER=shopcloud
POSTGRES_PASSWORD=shopcloud
POSTGRES_DB=shopcloud
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=6380
DATABASE_URL=postgres://shopcloud:shopcloud@postgres:5432/shopcloud
REDIS_URL=redis://redis:6379

CATALOG_SERVICE_URL=http://catalog:3001
CART_SERVICE_URL=http://cart:3002
CHECKOUT_SERVICE_URL=http://checkout:3003
AUTH_SERVICE_URL=http://auth:3004
ADMIN_SERVICE_URL=http://admin:3005

INVOICE_OUTPUT_DIR=/app/invoices
INVOICE_QUEUE_STREAM=invoice-events

GATEWAY_HOST_PORT=8080
