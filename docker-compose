services:
  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-shopcloud}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-shopcloud}
      POSTGRES_DB: ${POSTGRES_DB:-shopcloud}
    ports:
      - "${POSTGRES_HOST_PORT:-55432}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./database/init.sql:/docker-entrypoint-initdb.d/init.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-shopcloud} -d ${POSTGRES_DB:-shopcloud}"]
      interval: 5s
      timeout: 5s
      retries: 20

  redis:
    image: redis:7-alpine
    ports:
      - "${REDIS_HOST_PORT:-6380}:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 20

  # All five backends share one image. Each service overrides `command` to
  # pick its uvicorn entrypoint — matches what the K8s Deployments do.
  auth:
    image: shopcloud-app:local
    build: { context: ., dockerfile: Dockerfile }
    command: ["uvicorn", "services.auth.main:app", "--host", "0.0.0.0", "--port", "3004"]
    env_file: .env
    environment:
      PORT: 3004
      ROOT_PATH: /api/auth
    depends_on:
      postgres:
        condition: service_healthy

  catalog:
    image: shopcloud-app:local
    command: ["uvicorn", "services.catalog.main:app", "--host", "0.0.0.0", "--port", "3001"]
    env_file: .env
    environment:
      PORT: 3001
      ROOT_PATH: /api/catalog
    depends_on:
      auth:
        condition: service_started   # ensures the image is built once before fan-out
      postgres:
        condition: service_healthy

  cart:
    image: shopcloud-app:local
    command: ["uvicorn", "services.cart.main:app", "--host", "0.0.0.0", "--port", "3002"]
    env_file: .env
    environment:
      PORT: 3002
      ROOT_PATH: /api/cart
    depends_on:
      auth:
        condition: service_started
      redis:
        condition: service_healthy
      catalog:
        condition: service_started

  checkout:
    image: shopcloud-app:local
    command: ["uvicorn", "services.checkout.main:app", "--host", "0.0.0.0", "--port", "3003"]
    env_file: .env
    environment:
      PORT: 3003
      ROOT_PATH: /api/checkout
    depends_on:
      auth:
        condition: service_started
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

  admin:
    image: shopcloud-app:local
    command: ["uvicorn", "services.admin.main:app", "--host", "0.0.0.0", "--port", "3005"]
    env_file: .env
    environment:
      PORT: 3005
      ROOT_PATH: /api/admin
    depends_on:
      auth:
        condition: service_started
      postgres:
        condition: service_healthy

  # Admin-ui is a genuinely separate image (NGINX, not Python).
  admin-ui:
    image: shopcloud-admin-ui:local
    build:
      context: .
      dockerfile: admin-ui/Dockerfile
    ports:
      - "127.0.0.1:8081:80"
    depends_on:
      auth:
        condition: service_started
      admin:
        condition: service_started

  # The customer storefront is plain static assets — no Python, no container of
  # its own. The gateway serves them in dev; in prod the same files live in S3
  # fronted by CloudFront (see infra/terraform/modules/s3_frontend).
  gateway:
    image: nginx:1.27-alpine
    ports:
      - "${GATEWAY_HOST_PORT:-8090}:80"
    volumes:
      - ./gateway/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./frontend:/usr/share/nginx/html:ro
    depends_on:
      - auth
      - catalog
      - cart
      - checkout

volumes:
  postgres_data:
