# prod environment — composes the modules together.
# Run terraform from this directory: terraform init && terraform apply

terraform {
  required_version = ">= 1.6"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.region

  # Tags applied to every resource that supports them.
  default_tags {
    tags = {
      Project     = "shopcloud"
      Environment = "prod"
      ManagedBy   = "terraform"
    }
  }
}

# ----------------------------------------------------------------------------
# Network — VPC, subnets across 3 AZs, NAT gateway.
# Everything else lives inside this VPC.
# ----------------------------------------------------------------------------

module "network" {
  source = "../../modules/network"

  name     = "shopcloud"
  vpc_cidr = "10.0.0.0/16"
  azs      = ["eu-west-1a", "eu-west-1b", "eu-west-1c"]
}



# ----------------------------------------------------------------------------
# EKS — Kubernetes control plane + managed node group.
# Pods will run on the EC2 nodes this creates.
# ----------------------------------------------------------------------------
module "eks" {
  source = "../../modules/eks"

  name               = "shopcloud"
  kubernetes_version = "1.30"
  vpc_id             = module.network.vpc_id
  subnet_ids         = module.network.private_subnet_ids
}



# ----------------------------------------------------------------------------
# Data — RDS Postgres (Multi-AZ) and ElastiCache Redis.
# Both sit in private DB subnets, only reachable from the EKS nodes.
# ----------------------------------------------------------------------------
module "data" {
  source = "../../modules/data"

  name              = "shopcloud"
  vpc_id            = module.network.vpc_id
  db_subnet_ids     = module.network.database_subnet_ids
  redis_subnet_ids  = module.network.database_subnet_ids
  allowed_source_sg = module.eks.node_security_group_id

  db_username = "shopcloud"
  # Password is generated by the module and stored in Secrets Manager later.
  # For this first pass we accept it as a variable to keep things simple.
  db_password = var.db_password
}





# ----------------------------------------------------------------------------
# Storage — ECR repositories, one per service.
# CI pushes Docker images here; EKS pulls from here.
# ----------------------------------------------------------------------------
module "storage" {
  source = "../../modules/storage"

  services = ["catalog", "cart", "checkout", "auth", "admin", "admin-ui"]
}
